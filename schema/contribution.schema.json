{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opms.example.org/schema/0.3/contribution.schema.json",
  "title": "Contribution",
  "description": "A batch of static-feature observations from one contributor, kept separate from the consolidated map.",
  "type": "object",
  "required": [
    "id",
    "contributor_id",
    "submitted_at",
    "trace_window",
    "pseudonym",
    "redaction_attestation",
    "status"
  ],
  "properties": {
    "id": {
      "$ref": "common.schema.json#/$defs/Id",
      "description": "Contribution id."
    },
    "contributor_id": {
      "$ref": "common.schema.json#/$defs/Id",
      "description": "Organisation that collected the data."
    },
    "submitted_via_contributor_id": {
      "$ref": "common.schema.json#/$defs/Id",
      "description": "Licensed unit or gateway that received it, if routed."
    },
    "campaign_id": {
      "$ref": "common.schema.json#/$defs/Id",
      "description": "Campaign it responds to, if any."
    },
    "jurisdiction_id": {
      "$ref": "common.schema.json#/$defs/Id",
      "description": "Jurisdiction it was routed under."
    },
    "repository_id": {
      "$ref": "common.schema.json#/$defs/Id",
      "description": "Receiving repository."
    },
    "submitted_at": {
      "$ref": "common.schema.json#/$defs/DateTime"
    },
    "trace_window": {
      "type": "object",
      "required": [
        "start",
        "end"
      ],
      "additionalProperties": false,
      "properties": {
        "start": {
          "$ref": "common.schema.json#/$defs/DateTime"
        },
        "end": {
          "$ref": "common.schema.json#/$defs/DateTime"
        }
      },
      "description": "Time span of the vehicle trace that produced this contribution. start and end are RFC 3339 instants."
    },
    "facility_hint": {
      "type": "object",
      "additionalProperties": false,
      "description": "Where the trace was collected.",
      "properties": {
        "facility_id": {
          "$ref": "common.schema.json#/$defs/Id"
        },
        "site_id": {
          "$ref": "common.schema.json#/$defs/Id"
        },
        "bbox_wgs84": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 4,
          "maxItems": 4,
          "description": "Approximate WGS84 box where the trace was collected: [minimum longitude, minimum latitude, maximum longitude, maximum latitude], in degrees.",
          "examples": [
            [
              144.96,
              -37.82,
              144.97,
              -37.81
            ]
          ]
        }
      }
    },
    "sensor_profile": {
      "type": "object",
      "additionalProperties": false,
      "description": "Declared sensing capability.",
      "properties": {
        "sensors": {
          "type": "array",
          "items": {
            "enum": [
              "camera",
              "lidar",
              "radar",
              "ultrasonic",
              "imu",
              "wheel_odometry",
              "gnss"
            ]
          },
          "description": "Sensors used. camera, lidar, radar, ultrasonic, imu, wheel_odometry, gnss.",
          "examples": [
            [
              "lidar",
              "imu",
              "wheel_odometry"
            ]
          ]
        },
        "calibration_class": {
          "enum": [
            "uncalibrated",
            "factory",
            "fleet_calibrated",
            "survey_grade"
          ],
          "description": "How well the sensors are calibrated. uncalibrated, factory, fleet_calibrated, or survey_grade.",
          "examples": [
            "factory"
          ]
        },
        "odometry_drift_m_per_100m": {
          "type": "number",
          "minimum": 0,
          "description": "Claimed wheel-odometry drift, in metres per 100 metres travelled.",
          "examples": [
            0.5
          ]
        }
      }
    },
    "pseudonym": {
      "type": "object",
      "required": [
        "vehicle_token",
        "session_token",
        "pseudonym_epoch"
      ],
      "additionalProperties": false,
      "description": "Rotating tokens. No VIN or plate.",
      "properties": {
        "vehicle_token": {
          "type": "string",
          "minLength": 16,
          "description": "Rotating vehicle token, at least 16 characters. Not a VIN, plate or other direct identifier.",
          "examples": [
            "0123456789abcdef"
          ]
        },
        "session_token": {
          "type": "string",
          "minLength": 16,
          "description": "Rotating session token, at least 16 characters. Not a person's name.",
          "examples": [
            "fedcba9876543210"
          ]
        },
        "pseudonym_epoch": {
          "type": "string",
          "description": "Rotation period label, e.g. 2026-11."
        },
        "k_anonymity_group": {
          "type": "integer",
          "minimum": 1,
          "description": "Smallest group size the publisher claims this pseudonym shares. 1 means no k-anonymity claim.",
          "examples": [
            5
          ]
        }
      }
    },
    "redaction_attestation": {
      "type": "object",
      "required": [
        "policy_id",
        "performed_on_board",
        "imagery_included",
        "trajectories_included",
        "attested_at"
      ],
      "additionalProperties": false,
      "description": "Contributor's signed statement of what was removed.",
      "properties": {
        "policy_id": {
          "$ref": "common.schema.json#/$defs/Id"
        },
        "performed_on_board": {
          "type": "boolean",
          "description": "True when the redaction ran on the vehicle before upload.",
          "examples": [
            true
          ]
        },
        "imagery_included": {
          "type": "boolean",
          "description": "True when the payload still contains imagery.",
          "examples": [
            false
          ]
        },
        "trajectories_included": {
          "type": "boolean",
          "description": "True when the payload still contains trajectories.",
          "examples": [
            true
          ]
        },
        "trim_start_m": {
          "type": "number",
          "minimum": 0,
          "description": "Metres trimmed from the start of the trace so the journey origin is not kept.",
          "examples": [
            50
          ]
        },
        "trim_end_m": {
          "type": "number",
          "minimum": 0,
          "description": "Metres trimmed from the end of the trace so the journey destination is not kept.",
          "examples": [
            50
          ]
        },
        "time_jitter_applied": {
          "type": "boolean",
          "description": "True when timestamps were jittered to reduce re-identification.",
          "examples": [
            true
          ]
        },
        "attested_at": {
          "$ref": "common.schema.json#/$defs/DateTime"
        },
        "signature_ref": {
          "type": "string",
          "description": "Reference to the attestation signature. Not the signature bytes themselves.",
          "examples": [
            "sig-example-1"
          ]
        }
      }
    },
    "payload_ref": {
      "type": "object",
      "required": [
        "uri",
        "sha256"
      ],
      "additionalProperties": false,
      "description": "Optional bulk payload (e.g. a SENSORIS message set) held separately.",
      "properties": {
        "uri": {
          "type": "string",
          "format": "uri",
          "description": "URI of a bulk payload held outside this record, for example a SENSORIS message set.",
          "examples": [
            "https://example.org/payloads/example.bin"
          ]
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$",
          "description": "Lower-case hex SHA-256 of that payload, 64 digits.",
          "examples": [
            "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"
          ]
        },
        "media_type": {
          "type": "string",
          "description": "Media type of the payload.",
          "examples": [
            "application/octet-stream"
          ]
        }
      }
    },
    "licence": {
      "$ref": "common.schema.json#/$defs/LicenceTerms"
    },
    "status": {
      "enum": [
        "received",
        "rejected",
        "accepted"
      ],
      "description": "Processing status."
    },
    "rejection_reason": {
      "type": "string",
      "description": "Reason when rejected."
    },
    "_note": {
      "type": "string",
      "description": "Free-text note; used to label fictional example data."
    }
  },
  "patternProperties": {
    "^x_": {}
  },
  "additionalProperties": false
}
