{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opms.example.org/schema/0.2/destination.schema.json",
  "title": "Destination",
  "description": "Where passengers are going.",
  "type": "object",
  "required": [
    "id",
    "kind",
    "name",
    "portal_ids"
  ],
  "properties": {
    "id": {
      "$ref": "common.schema.json#/$defs/Id",
      "description": "Destination id."
    },
    "kind": {
      "enum": [
        "store",
        "cinema",
        "food_court",
        "supermarket",
        "mall_door",
        "lift_lobby",
        "terminal",
        "hospital_entrance",
        "emergency_dept",
        "residence"
      ],
      "description": "Destination kind."
    },
    "name": {
      "type": "string",
      "description": "Display name."
    },
    "level_label": {
      "type": "string",
      "description": "Level as signed."
    },
    "portal_ids": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/Id"
      },
      "description": "Doors people use to reach it."
    },
    "hours": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/TimeWindow"
      },
      "description": "Opening hours."
    },
    "provenance": {
      "$ref": "common.schema.json#/$defs/Provenance"
    },
    "evidence": {
      "$ref": "common.schema.json#/$defs/Evidence"
    },
    "lifecycle": {
      "$ref": "common.schema.json#/$defs/Lifecycle"
    },
    "supersedes": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/Id"
      },
      "description": "IDs of earlier features this one replaces (for tombstoning and diffs)."
    },
    "valid_from": {
      "$ref": "common.schema.json#/$defs/DateTime",
      "description": "Start of validity, for planned changes."
    },
    "valid_to": {
      "$ref": "common.schema.json#/$defs/DateTime",
      "description": "End of validity."
    },
    "external_refs": {
      "$ref": "common.schema.json#/$defs/ExternalRefs"
    },
    "_note": {
      "type": "string",
      "description": "Free-text note; used to label fictional example data."
    }
  },
  "patternProperties": {
    "^x_": {}
  },
  "additionalProperties": false
}
