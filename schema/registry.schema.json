{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opms.example.org/schema/0.3/registry.schema.json",
  "title": "OPMS registry",
  "description": "Jurisdictions, repositories, contributors and policies. Published by repositories or authorities, separate from site datasets.",
  "type": "object",
  "required": [
    "opms_version",
    "jurisdictions",
    "repositories"
  ],
  "additionalProperties": false,
  "patternProperties": {
    "^x_": {}
  },
  "properties": {
    "_note": {
      "type": "string",
      "description": "Free-text note. Used to label fictional example data. Not a registry fact.",
      "examples": [
        "Fictional registry."
      ]
    },
    "opms_version": {
      "type": "string",
      "pattern": "^0[.][23][.][0-9]+$",
      "description": "Schema version. 0.2.x remains valid. 0.3 adds located geometry and verification."
    },
    "jurisdictions": {
      "type": "array",
      "items": {
        "$ref": "jurisdiction.schema.json"
      },
      "description": "Jurisdictions."
    },
    "repositories": {
      "type": "array",
      "items": {
        "$ref": "repository.schema.json"
      },
      "description": "Repositories."
    },
    "contributors": {
      "type": "array",
      "items": {
        "$ref": "contributor.schema.json"
      },
      "description": "Contributors."
    },
    "resolution_policies": {
      "type": "array",
      "items": {
        "$ref": "resolution-policy.schema.json"
      },
      "description": "Policies."
    },
    "redaction_policies": {
      "type": "array",
      "items": {
        "$ref": "redaction-policy.schema.json"
      },
      "description": "Policies."
    },
    "campaigns": {
      "type": "array",
      "items": {
        "$ref": "campaign.schema.json"
      },
      "description": "Open campaigns."
    }
  }
}
