{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opms.example.org/schema/0.3/review.schema.json",
  "title": "Review",
  "description": "Standalone sign-off of one dataset version. Not part of the map. A future review tool writes this document; v0.3 only defines its shape.",
  "type": "object",
  "required": [
    "opms_version",
    "id",
    "dataset_id",
    "dataset_version",
    "reviewer_role",
    "reviewed_at",
    "entries"
  ],
  "additionalProperties": false,
  "patternProperties": {
    "^x_": {}
  },
  "properties": {
    "_note": {
      "type": "string",
      "description": "Free-text note. Used to label fictional example data. Not a review result.",
      "examples": [
        "Fictional review."
      ]
    },
    "opms_version": {
      "type": "string",
      "pattern": "^0[.][23][.][0-9]+$",
      "description": "Schema version."
    },
    "id": {
      "$ref": "common.schema.json#/$defs/Id",
      "description": "Review id."
    },
    "dataset_id": {
      "$ref": "common.schema.json#/$defs/Id",
      "description": "Site id of the dataset reviewed."
    },
    "dataset_version": {
      "$ref": "common.schema.json#/$defs/Version",
      "description": "Dataset version reviewed."
    },
    "reviewer_role": {
      "enum": [
        "owner",
        "operator",
        "authority",
        "crowd"
      ],
      "description": "Role of the reviewing organisation."
    },
    "reviewer_ref": {
      "type": "string",
      "description": "Organisation label. Not a person's name."
    },
    "reviewed_at": {
      "$ref": "common.schema.json#/$defs/DateTime",
      "description": "When the sign-off was made."
    },
    "sign_off": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status"
      ],
      "description": "Overall result. Partial means some entries are not confirmed.",
      "properties": {
        "status": {
          "enum": [
            "accepted",
            "rejected",
            "partial"
          ],
          "description": "Overall sign-off."
        },
        "note": {
          "type": "string",
          "description": "Short note. No personal data."
        }
      }
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "description": "Per-feature results. feature_id is the id in the dataset.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "feature_id",
          "role",
          "status",
          "reviewed_at",
          "dataset_version"
        ],
        "properties": {
          "feature_id": {
            "$ref": "common.schema.json#/$defs/Id",
            "description": "Feature reviewed."
          },
          "role": {
            "enum": [
              "owner",
              "operator",
              "authority",
              "crowd"
            ],
            "description": "Reviewer role for this entry."
          },
          "status": {
            "enum": [
              "confirmed",
              "incorrect",
              "missing",
              "not-checked"
            ],
            "description": "Result for this feature."
          },
          "note": {
            "type": "string",
            "description": "Short note on this feature. No names, plates or diagnoses.",
            "examples": [
              "Threshold matches the painted line."
            ]
          },
          "evidence_ref": {
            "type": "string",
            "description": "Pointer to external evidence."
          },
          "reviewed_at": {
            "$ref": "common.schema.json#/$defs/DateTime"
          },
          "dataset_version": {
            "$ref": "common.schema.json#/$defs/Version"
          }
        }
      }
    }
  }
}
