{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opms.example.org/schema/0.3/zone.schema.json",
  "title": "Zone",
  "description": "A painted area of bays.",
  "type": "object",
  "required": [
    "id",
    "level_id",
    "name"
  ],
  "properties": {
    "id": {
      "$ref": "common.schema.json#/$defs/Id",
      "description": "Zone id."
    },
    "level_id": {
      "$ref": "common.schema.json#/$defs/Id",
      "description": "Parent level."
    },
    "name": {
      "type": "string",
      "description": "Signed name, e.g. Blue C."
    },
    "bay_types": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/Id"
      },
      "description": "Optional hint of dominant bay classes (free ids such as ev, accessible)."
    },
    "polygon": {
      "$ref": "common.schema.json#/$defs/LocalPolygon",
      "description": "Painted area in the facility frame."
    },
    "verifications": {
      "type": "array",
      "description": "Reviews of this feature against the real place. Absent means not checked. A later review tool writes these; the schema only stores them.",
      "items": {
        "$ref": "common.schema.json#/$defs/Verification"
      }
    },
    "provenance": {
      "$ref": "common.schema.json#/$defs/Provenance"
    },
    "evidence": {
      "$ref": "common.schema.json#/$defs/Evidence"
    },
    "lifecycle": {
      "$ref": "common.schema.json#/$defs/Lifecycle"
    },
    "supersedes": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/Id"
      },
      "description": "IDs of earlier features this one replaces (for tombstoning and diffs)."
    },
    "valid_from": {
      "$ref": "common.schema.json#/$defs/DateTime",
      "description": "Start of validity, for planned changes."
    },
    "valid_to": {
      "$ref": "common.schema.json#/$defs/DateTime",
      "description": "End of validity."
    },
    "external_refs": {
      "$ref": "common.schema.json#/$defs/ExternalRefs"
    },
    "_note": {
      "type": "string",
      "description": "Free-text note; used to label fictional example data."
    }
  },
  "patternProperties": {
    "^x_": {}
  },
  "additionalProperties": false
}
