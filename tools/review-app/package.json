{
  "name": "opms-review-app",
  "private": true,
  "type": "module",
  "version": "0.3.0",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "boundaries": "depcruise src --config .dependency-cruiser.cjs",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:bdd": "NODE_OPTIONS='--import tsx' cucumber-js --strict --import test/bdd/steps.ts features",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "preact": "^10.25.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.1",
    "@cucumber/cucumber": "^11.2.0",
    "@eslint/js": "^9.17.0",
    "@preact/preset-vite": "^2.9.3",
    "@types/node": "^22.10.5",
    "@vitest/coverage-v8": "^2.1.8",
    "dependency-cruiser": "^16.9.0",
    "eslint": "^9.17.0",
    "playwright": "^1.49.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.19.0",
    "vite": "^6.0.7",
    "vitest": "^2.1.8"
  }
}
